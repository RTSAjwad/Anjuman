{
  "name": "anjuman-react-shell",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm:build": "cd ../../shared && boltffi pack wasm",
    "types:build": "cd ../../shared && cargo run --features codegen -p shared --bin codegen -- --language typescript --output-dir ../shells/react/generated/types",
    "dev": "react-router dev",
    "build": "pnpm run wasm:build && pnpm run types:build && react-router build",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@boltffi/runtime": "0.30.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.61.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.0",
    "shadcn": "^4.22.1",
    "shared": "file:./generated/pkg",
    "shared_types": "file:./generated/types",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vite-plugin-wasm": "^3.4.1"
  }
}
