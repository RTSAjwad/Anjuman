# Anjuman — monorepo root .gitignore
#
# This repo is a single git repository containing three independent Cargo
# workspaces as subdirectories: `client/`, `server/`, and `contracts/`.
# Per-folder .gitignore files handle workspace-specific ignores.

# Rust / Cargo build output (each workspace may have its own /target)
target/
**/target/

# Environment / secrets — never commit real credentials.
.env
**/.env

# Local Postgres data dir (created by services-flake via `nix run .#anjuman`)
# and any stray SQLite files left over from before the migration.
/data
*.db
*.db-shm
*.db-wal
*.db.backup
*.db.bak

# Nix / direnv
.direnv/
result/

# Editor / OS cruft
.DS_Store
*.swp
.idea/
.vscode/
